{
  "projectId": "cbd619a7-058d-4526-a8c6-77bceb6470e5",
  "shape": "storybook",
  "pkg": "m3you",
  "readmeHeader": ".design-sync/conventions.md",
  "storybookStatic": ".design-sync/sb-reference",
  "storybookConfigDir": ".storybook",
  "buildCmd": "bun run build && mkdir -p .design-sync/.cache && cat dist/styles/globals.css .design-sync/preview-base.css > .design-sync/.cache/ds-css-entry.css",
  "entry": "dist/index.js",
  "cssEntry": ".design-sync/.cache/ds-css-entry.css",
  "extraFonts": [".design-sync/fonts/roboto-flex.css"],
  "runtimeFontPrefixes": ["https://fonts.gstatic.com"],
  "libOverrides": {
    "dts.mjs": "FAB is a real component; the ALL-CAPS heuristic in isComponentName would drop it as an object constant"
  },
  "titleMap": {
    "FAB": "FAB",
    "Search": "SearchBar",
    "M3ComponentReplacements": null,
    "InteractionPlayground": null
  },
  "overrides": {
    "LinearProgress": { "cardMode": "column" },
    "Snackbar": { "cardMode": "column" },
    "Card": { "cardMode": "column" },
    "Dialog": { "cardMode": "column" },
    "List": { "cardMode": "column" },
    "TextField": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "Toolbar": { "cardMode": "column" },
    "RadioButton": { "cardMode": "column" },
    "Slider": { "cardMode": "column" },
    "Switch": { "viewport": "900x1000" },
    "Menu": { "cardMode": "single", "primaryStory": "Showcase", "viewport": "900x1000" },
    "Tooltip": { "cardMode": "single" }
  }
}
