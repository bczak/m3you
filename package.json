{
  "name": "m3you",
  "version": "0.1.0",
  "description": "Material Design 3 component library for React, built with Tailwind CSS v4",
  "type": "module",
  "license": "MIT",
  "author": "bczak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bczak/m3you.git"
  },
  "homepage": "https://github.com/bczak/m3you#readme",
  "bugs": {
    "url": "https://github.com/bczak/m3you/issues"
  },
  "keywords": [
    "material-design",
    "material-design-3",
    "m3",
    "react",
    "components",
    "ui",
    "tailwindcss",
    "design-system"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/globals.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rslib build",
    "build-storybook": "storybook build",
    "check": "biome check --write",
    "dev": "rslib build --watch",
    "doc": "rspress dev",
    "doc:build": "rspress build",
    "doc:preview": "rspress preview",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "storybook": "storybook dev -p 6006",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "chromatic": "npx chromatic",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@material/material-color-utilities": "^0.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "m3-ripple": "^1.1.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@chromatic-com/storybook": "^5.0.1",
    "@rsbuild/core": "^1.7.2",
    "@rsbuild/plugin-react": "^1.4.4",
    "@rslib/core": "^0.19.4",
    "@rspress/core": "^2.0.1",
    "@rspress/plugin-api-docgen": "^2.0.1",
    "@rspress/plugin-preview": "^2.0.1",
    "@rstest/adapter-rslib": "^0.2.0",
    "@rstest/core": "^0.8.1",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.3",
    "@storybook/addon-onboarding": "^10.2.3",
    "@storybook/react": "^10.2.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "chromatic": "^15.1.0",
    "happy-dom": "^20.4.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rsbuild-plugin-workspace-dev": "^0.1.3",
    "storybook": "^10.2.3",
    "storybook-addon-rslib": "^3.2.2",
    "storybook-react-rsbuild": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
