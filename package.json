{
  "name": "m3you",
  "version": "0.1.0",
  "description": "Material Design 3 Expressive component library for React",
  "type": "module",
  "license": "MIT",
  "author": "bczak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bczak/m3you.git"
  },
  "homepage": "https://github.com/bczak/m3you#readme",
  "bugs": {
    "url": "https://github.com/bczak/m3you/issues"
  },
  "keywords": [
    "material-design",
    "material-design-3",
    "m3",
    "react",
    "components",
    "ui",
    "css-custom-properties",
    "design-system",
    "design-tokens"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/globals.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "check": "biome check --write",
    "dev": "vite build --watch",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "chromatic": "npx chromatic",
    "prepublishOnly": "bun run build",
    "react-doctor": "bunx react-doctor@latest . --fail-on warning"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@material/material-color-utilities": "^0.4.0",
    "lucide-react": "^1.14.0",
    "m3-ripple": "^1.1.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.4",
    "@vitest/coverage-v8": "4.1.4",
    "happy-dom": "^20.9.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
