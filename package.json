{
  "name": "m3you",
  "version": "0.2.0",
  "description": "Material Design 3 Expressive component library for React",
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "license": "MIT",
  "author": "bczak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bczak/m3you.git"
  },
  "homepage": "https://github.com/bczak/m3you#readme",
  "bugs": {
    "url": "https://github.com/bczak/m3you/issues"
  },
  "keywords": [
    "material-design",
    "material-design-3",
    "m3",
    "react",
    "components",
    "ui",
    "css-custom-properties",
    "design-system",
    "design-tokens"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/globals.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "check": "biome check --write",
    "prepare": "lefthook install",
    "coverage": "vitest run --project unit --coverage",
    "dev": "vite build --watch",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "types:check": "tsc --noEmit",
    "test:watch": "vitest",
    "chromatic": "bunx chromatic",
    "prepublishOnly": "bun run build",
    "doctor": "bunx react-doctor@latest . --blocking warning",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "deploy:docs": "bun run docs:build && bunx wrangler pages deploy docs/.output/public --project-name m3you-docs --branch development",
    "deploy:storybook": "bun run build-storybook && bunx wrangler pages deploy storybook-static --project-name m3you-storybook --branch development"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@material/material-color-utilities": "0.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.21.0",
    "m3-ripple": "1.1.3",
    "sonner": "2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-onboarding": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.0.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "happy-dom": "20.10.6",
    "lefthook": "^2.1.10",
    "playwright": "1.61.1",
    "postcss": "8.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semantic-release": "^25.0.8",
    "storybook": "10.4.6",
    "tailwindcss": "4.3.1",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.9"
  }
}
